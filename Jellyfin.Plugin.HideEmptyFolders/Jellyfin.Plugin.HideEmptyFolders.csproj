<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>SA1010,SA1011,SA1513</NoWarn>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Configuration/hideemptyfolders.html" />
    <None Remove="Configuration/hideemptyfolders.js" />
    <EmbeddedResource Include="Configuration/hideemptyfolders.html" />
    <EmbeddedResource Include="Configuration/hideemptyfolders.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Jellyfin.Data" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Controller" Version="10.11.11" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" PrivateAssets="All" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118" PrivateAssets="All" />
    <PackageReference Include="SmartAnalyzers.MultithreadingAnalyzer" Version="1.1.31" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <PropertyGroup>
    <CodeAnalysisRuleSet>../jellyfin.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
</Project>
